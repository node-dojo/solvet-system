{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NO3D Tools Product Metadata Schema",
  "description": "Schema for validating product metadata JSON files in the NO3D Tools library",
  "type": "object",
  "required": [
    "title",
    "handle",
    "description",
    "vendor",
    "product_type",
    "tags",
    "status",
    "variants",
    "metafields"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Product title/name"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 100,
      "description": "URL-friendly product handle (lowercase, hyphens only)"
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 5000,
      "description": "Product description"
    },
    "vendor": {
      "type": "string",
      "enum": ["The Well Tarot"],
      "description": "Product vendor"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "Blender Add-on",
        "Geometry Node",
        "Material",
        "Collection",
        "Mesh Object",
        "Node Group",
        "Tool",
        "tools"
      ],
      "description": "Type of Blender asset"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "minItems": 0,
      "maxItems": 20,
      "uniqueItems": true,
      "description": "Product tags for categorization"
    },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "archived"],
      "description": "Product status"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["price", "sku", "inventory_policy", "inventory_management"],
        "properties": {
          "price": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$",
            "description": "Price in format XX.XX"
          },
          "sku": {
            "type": "string",
            "pattern": "^NO3D-TOOLS-[A-Z0-9._-]+$",
            "description": "Stock keeping unit with NO3D-TOOLS prefix"
          },
          "inventory_policy": {
            "type": "string",
            "enum": ["continue", "deny"],
            "description": "Inventory policy"
          },
          "inventory_management": {
            "type": "string",
            "enum": ["shopify", "polar"],
            "description": "Inventory management system"
          }
        }
      },
      "minItems": 1,
      "maxItems": 5,
      "description": "Product variants"
    },
    "metafields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["namespace", "key", "value"],
        "properties": {
          "namespace": {
            "type": "string",
            "description": "Metafield namespace"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Metafield key"
          },
          "value": {
            "type": ["string", "number", "boolean", "null"],
            "description": "Metafield value"
          },
          "type": {
            "type": "string",
            "description": "Metafield data type"
          },
          "hosted_url": {
            "type": "string",
            "format": "uri",
            "description": "Hosted URL for file assets"
          }
        }
      },
      "description": "Product metafields"
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "source_file": { "type": "string" },
        "created_at": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"] },
        "asset_file_updates": { "type": "array" }
      }
    },
    "hosted_media": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" },
      "description": "Map of filenames to hosted URLs"
    },
    "carousel_media": {
      "type": "array",
      "items": { "type": "string" }
    },
    "excluded_carousel_media": {
      "type": "array",
      "items": { "type": "string" }
    },
    "main_image": {
      "type": ["string", "null"]
    },
    "thumbnail_image": {
      "type": ["string", "null"]
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string" },
          "description": { "type": "string" },
          "filePath": { "type": "string" }
        }
      }
    },
    "polar": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
